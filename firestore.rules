rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Update the admin email below to match AUTH_ROLES.ADMIN_EMAILS in js/firebase-config.js
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "admin@tuition.lms" ||
        request.auth.token.email == "udana123@gmail.com"
      );
    }

    match /subjects/{subjectId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /materials/{materialId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloads']) &&
        request.resource.data.downloads == resource.data.downloads + 1
      );
    }
  }
}
